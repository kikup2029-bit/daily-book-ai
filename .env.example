# SimpleBooks — server environment
#
# Copy to .env for local development. NEVER commit a filled-in copy.
#
# ─────────────────────────────────────────────────────────────────────────────
# HOW THESE REACH PRODUCTION — read before deploying
# ─────────────────────────────────────────────────────────────────────────────
# vite.config.ts inlines some of these into the built bundle at build time,
# because of how this Cloudflare setup passes variables. That's fine for public
# values and tolerable for the AI keys.
#
# It is NOT acceptable for the Stripe keys below. They are read at RUNTIME only
# and must be set as encrypted Worker secrets:
#
#   Cloudflare dashboard → Workers → daily-book-ai → Settings →
#     Variables and Secrets → Add → type "Secret" (encrypted)
#   or:  wrangler secret put STRIPE_SECRET_KEY
#
# If a Stripe key is ever added to the `define` block in vite.config.ts it ends
# up in the JavaScript bundle. Rotate it immediately if that happens.

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Bypasses row-level security. Server only. Required for Stripe webhooks to
# write subscription state.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (runtime secrets only — see the warning above) ───────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Price id from Stripe → Products → Pricing. Looks like price_1AbCd...
# NOT the product id (prod_...).
STRIPE_PRICE_PRO_MONTHLY=

# ── AI providers (all optional) ─────────────────────────────────────────────
# Without any of these, "Ask about your money" uses the built-in answers engine
# and receipt scanning is unavailable. Everything else works.
GROQ_API_KEY=
GROQ_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
